# Desarrollo y pruebas locales. Copiar a .env (ignorado por Git).
# Generar una contraseña local; nunca versionar el valor real.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Conexión desde el host; dentro de Compose, el host será postgres.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=gymtrack
DB_DATABASE=gymtrack
DB_TEST_DATABASE=gymtrack_test
# Usar POSTGRES_PASSWORD como contraseña de conexión en ambos entornos.
# Si se cambia POSTGRES_PORT, ajustar DB_PORT al mismo valor.

# TLS: por defecto ~/.local/share/gymtrack/tls (generado por npm run tls:local).
# Opcional: directorio absoluto alternativo, también usado por tls:local.
# Exportar GYMTRACK_TLS_DIR antes de tls:local si se cambia.
GYMTRACK_TLS_DIR=
# Entrega: rutas absolutas al certificado con cadena y clave provistos por el entorno.
TLS_CERT_PATH=
TLS_KEY_PATH=
# CA adicional para proxy/E2E Node; en local se usa ca.pem del directorio anterior.
TLS_CA_PATH=

# AuthModule (se conecta a AppModule en T023). Generar al menos 32 bytes aleatorios;
# nunca versionar el secreto real. Obligatorio también en desarrollo y pruebas.
JWT_SECRET=

# Mailpit local (T043A). SMTP interno sin credenciales; puertos publicados solo en loopback.
# Desde contenedores, SMTP_HOST=mailpit y SMTP_PORT=1025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=GymTrack <noreply@example.invalid>
MAILPIT_PORT=8025
MAILPIT_URL=https://localhost:8025
# Si cambias MAILPIT_PORT, ajusta también MAILPIT_URL.
# Panel y API usan TLS_CERT_PATH/TLS_KEY_PATH o los certificados locales por defecto.

# Origen HTTPS usado en los enlaces de recuperación (obligatorio en producción).
FRONTEND_URL=https://localhost:5173
# SMTP de entrega: TLS implícito si true; en producción exige STARTTLS si false.
SMTP_SECURE=false
# Opcionales; configurar ambos o ninguno. Nunca versionar credenciales reales.
SMTP_USER=
SMTP_PASSWORD=

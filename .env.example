# Desarrollo y pruebas locales. Copiar a .env (ignorado por Git).
# Generar una contraseña local; nunca versionar el valor real.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Conexión desde el host; dentro de Compose, el host será postgres.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=gymtrack
DB_DATABASE=gymtrack
DB_TEST_DATABASE=gymtrack_test
# Usar POSTGRES_PASSWORD como contraseña de conexión en ambos entornos.
# Si se cambia POSTGRES_PORT, ajustar DB_PORT al mismo valor.

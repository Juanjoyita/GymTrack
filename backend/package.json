{
  "name": "@gymtrack/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "ts-node src/main.ts",
    "db:migrate": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "db:migrate:test": "cross-env NODE_ENV=test typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "pretest": "npm run build --workspace @gymtrack/domain",
    "prebuild": "npm run build --workspace @gymtrack/domain",
    "pretypecheck": "npm run build --workspace @gymtrack/domain",
    "predev": "npm run build --workspace @gymtrack/domain"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "dotenv": "^16.4.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "typeorm": "~0.3.28",
    "@gymtrack/domain": "*",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "argon2": "^0.44.0",
    "nodemailer": "^10.5.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "@types/nodemailer": "^7.0.0",
    "cross-env": "^10.1.0"
  }
}
